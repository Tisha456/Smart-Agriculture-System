SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# REQUIRED as of v4.0 — the automation engine reads/writes device_config,
# device_status and telemetry_data, all of which are RLS-protected to the
# owning user. The backend has no logged-in user, so it needs the
# service_role key to bypass RLS (each endpoint manually re-checks device
# ownership after validating the caller's JWT — see backend/main.py).
# Find it in Supabase dashboard -> Project Settings -> API -> service_role.
# NEVER expose this key to the browser/frontend — server-side only.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Plant disease diagnosis (Phase H/I/J) — OPTIONAL override. Without these,
# /api/plant/predict falls back to Gemini vision (needs GEMINI_API_KEY below).
# Set both once the ml/ model is trained and deployed to switch to it instead.
# PLANT_API_URL is the live Cloud Run URL from serving/DEPLOY.md step 5.
# PLANT_API_KEY is the SAME key you generated in serving/DEPLOY.md step 2 —
# it must match what the plant-disease API's API_KEY env var is set to.
# NEVER expose this key to the browser/app — server-side only, this backend
# is the only thing that ever sends it.
PLANT_API_URL=
PLANT_API_KEY=

# Gemini — powers the farm advisor chat (/api/advisor/ask) AND, when
# PLANT_API_URL/PLANT_API_KEY above are unset, the plant photo diagnosis
# (/api/plant/predict). Without this, both return 503.
# Get a free key at https://aistudio.google.com/apikey
# NEVER expose this key to the browser/app — server-side only.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ESP32-CAM live view — optional. Without this, /api/camera/* routes return
# 503 and everything else keeps working. Any long random string; it must
# match the CAM_UPLOAD_KEY #define in esp32_firmware/AgriSense_ESP32CAM.
# NEVER expose this key to the browser/app — server-side only.
CAM_UPLOAD_KEY=your_camera_upload_key_here
