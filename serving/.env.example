# Copy to .env and fill in before running locally or deploying.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace_with_a_strong_random_key

# Directory containing registry.json and the exported ONNX models,
# downloaded from Drive/exported/ at the end of Phase G. Mirrors the
# structure: models/registry.json, models/stage1/species.onnx,
# models/stage2/<species>.onnx, models/detector/leaf_detector.onnx
MODEL_DIR=./models

# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Simple per-key rate limit: requests allowed per window
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
